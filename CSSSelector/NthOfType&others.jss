/*
:first-of-type selects the first element of a particular type among its siblings
Example:
<div>
    <p>First paragraph</p>
    <p>Second paragraph</p>
    <p>Third paragraph</p>
</div>
selector: p:first-of-type
*/

/*
:last-of-type - This selector targets the very last element of a specific tag within its parent.
Example:
<div>
    <p>Item 1</p>
    <p>Item 2</p>
    <p>Item 3</p>
</div>
selector: p:last-of-type
*/

/*
nth-of-type() - selects an element based on its position among its siblings of the same HTML tag type.
Example:
<ul>
    <li>Home</li>
    <li>Products</li>
    <li>Services</li>
    <li>Contact</li>
</ul>
selector: li:nth-of-type(2) //Output - Products
*/